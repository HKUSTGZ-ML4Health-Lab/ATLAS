{
  "name": "ATLAS blinded clinician evaluation",
  "cases": 40,
  "reviewers": 3,
  "sampling": {
    "Western Multimorbidity Evaluation Set": 20,
    "GeriMedBench": 20,
    "selection_rule": "benchmark-stratified sampling independent of automatic scores and model wins"
  },
  "systems": [
