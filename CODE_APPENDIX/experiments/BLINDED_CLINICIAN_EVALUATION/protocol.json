    "independent_A_B_assignment_per_reviewer": true
  },
  "criteria": [
    "Clinical correctness",
    "Medication safety",
    "Decision completeness",
    "Actionability",
    "Evidence consistency"
  ],
  "scale": "integer 1-5",
  "additional_judgments": [
    "potentially unsafe recommendation",
    "pairwise output preference"
  ],
  "status": "completed",
  "result_source": "completed blinded clinician evaluation"
}
